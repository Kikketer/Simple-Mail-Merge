# Copy this file to release.env and fill in your values.
# release.env is gitignored — never commit real credentials.

# The full name of your "Developer ID Application" certificate as shown by:
#   security find-identity -v -p codesigning
ELECTROBUN_DEVELOPER_ID="Developer ID Application: Your Name (TEAMID)"

# Your Apple Developer Team ID (the 10-char code in the cert name above)
ELECTROBUN_TEAMID="TEAMID"

# App Store Connect API key for notarization.
# Create one at https://appstoreconnect.apple.com/access/integrations/api
ELECTROBUN_APPLEAPIISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ELECTROBUN_APPLEAPIKEY="XXXXXXXXXX"
# Path to the downloaded AuthKey_XXXXXXXXXX.p8 file
ELECTROBUN_APPLEAPIKEYPATH="/path/to/AuthKey_XXXXXXXXXX.p8"
