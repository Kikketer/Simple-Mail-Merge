{
  "name": "bulk-mailer",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "hutch electrobun dev --watch",
    "build": "hutch electrobun build --env=stable",
    "build:signed": "bash -c 'set -a; source release.env; set +a; bun run build'",
    "release": "bash -c 'set -a; source release.env; set +a; ./scripts/release.sh \"$@\"' bash"
  },
  "dependencies": {
    "electrobun": "2.0.1",
    "juice": "^12.2.0",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "8.0.2",
    "typescript": "^5.6.0"
  }
}
